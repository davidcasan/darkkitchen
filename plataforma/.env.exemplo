# Modelo do arquivo de configuração. Copie para ".env.local" (na mesma pasta) e preencha.
# O .env.local NÃO vai para o GitHub: ele guarda senhas.
# Depois de mudar algo, reinicie o servidor (em produção: scripts\atualizar.ps1, que também recompila).

# ---------- Endereço ----------
# Endereço público da plataforma: usado nos links dos e-mails e para liberar os formulários.
APP_URL=https://app.darkkitchen.art.br
# Outros endereços que também abrem a plataforma, separados por vírgula (opcional).
# DOMINIOS_EXTRA=darkkitchen.art.br,www.darkkitchen.art.br

# ---------- Admin inicial (só na primeira vez, com o banco vazio) ----------
# Em produção, se não houver nenhum admin, a plataforma cria este. Entre, troque a senha
# em Conta e depois APAGUE a linha ADMIN_SENHA_INICIAL.
ADMIN_EMAIL=seu-email@darkkitchen.art.br
ADMIN_NOME=Seu Nome
ADMIN_SENHA_INICIAL=troque-por-uma-senha-longa

# ---------- E-mail (UOL Host) ----------
SMTP_HOST=smtps.uhserver.com
SMTP_PORT=465
SMTP_USUARIO=noreply@darkkitchen.art.br
SMTP_SENHA=coloque-a-senha-aqui
EMAIL_REMETENTE=Dark Kitchen Studio <noreply@darkkitchen.art.br>
EMAIL_RESPONDER_PARA=sac@darkkitchen.art.br

# ---------- Atendimento pelo Telegram (opcional) ----------
# Token do bot criado no @BotFather. Só UMA máquina pode usar o mesmo token
# (deixe só no servidor). Sem token, o recurso fica desligado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USUARIO=atendimentoDKStudio_bot

# ---------- IA Comp (opcional; ligada/desligada na tela IA Comp do admin) ----------
# Chave da API da Anthropic (console.anthropic.com). Cada pedido com IA gasta créditos.
ANTHROPIC_API_KEY=
# Senha comprida que a máquina operária usa para falar com o site (a mesma nos dois .env.local).
IA_COMP_TOKEN_MAQUINA=
# Só na máquina operária: endereço do site.
IA_COMP_SERVIDOR=https://darkkitchen.art.br

# ---------- Backup diário ----------
# Pasta onde guardar as cópias (de preferência sincronizada com OneDrive ou Google Drive).
BACKUP_DESTINO=C:\Users\SEU-USUARIO\OneDrive\Backup Dark Kitchen
# Quantos dias de cópias do banco guardar.
BACKUP_DIAS=30
